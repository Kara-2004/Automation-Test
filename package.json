{
  "name": "ddbd-playwright-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Safe Playwright automation framework for the DDBD system.",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "test:regression": "playwright test --grep @regression --project=chromium",
    "test:crud": "playwright test --grep @destructive --project=chromium",
    "test:security": "playwright test --grep @security --project=chromium",
    "test:long": "playwright test --grep @long-running --project=chromium",
    "test:headed": "playwright test --headed --project=chromium",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug --project=chromium",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "import:testcases": "tsx scripts/import-testcases.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.3",
    "dotenv": "^16.6.1",
    "eslint": "^10.8.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
